{
	"name": "neuroarxiv",
	"version": "0.1.1",
	"description": "NeuroArxiv — a skill for coding agents. Before you build something new, it reads arXiv category-wise in parallel isolated passes (the divergent half), then converges on one recommended path grounded in real papers, with citations, a first step, and known prior-art failure modes to avoid.",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"bin": {
		"neuroarxiv": "src/cli.ts"
	},
	"files": [
		"dist",
		"src",
		"skills",
		"plugin.json",
		".codex-plugin",
		".claude-plugin",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "bunx --bun tsc",
		"test": "bun test tests/*.test.ts",
		"typecheck": "bunx --bun tsc --noEmit",
		"prepare": "bun run build",
		"prepublishOnly": "bun run build",
		"dev": "bun run src/cli.ts",
		"start": "bun dist/cli.js",
		"version:set": "bun scripts/update-version.mjs"
	},
	"keywords": [
		"arxiv",
		"research",
		"prior-art",
		"literature-review",
		"architecture",
		"claude",
		"claude-agent-sdk",
		"agent",
		"agents",
		"ai",
		"llm",
		"skill"
	],
	"license": "MIT",
	"author": "",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/UditAkhourii/neuroarxiv.git"
	},
	"homepage": "https://github.com/UditAkhourii/neuroarxiv#readme",
	"bugs": {
		"url": "https://github.com/UditAkhourii/neuroarxiv/issues"
	},
	"engines": {
		"bun": ">=1.4.0"
	},
	"dependencies": {
		"@anthropic-ai/claude-agent-sdk": "^0.3.246",
		"p-limit": "^7.3.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/bun": "^1.4.0",
		"typescript": "^7.0.2"
	}
}
